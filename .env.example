# Gateway Server configuration
PORT=8080

# Supabase self-hosted MCP Endpoint to proxy to
# Example: https://supabase.yourdomain.com/mcp
SUPABASE_MCP_URL=http://localhost:8081/mcp

# Secret key used to verify the incoming Bearer JWT tokens
# Ensure this is a strong, cryptographically secure key in production
JWT_SECRET=your_super_secret_key_change_me_in_production

# Administrator password to access the UI Control Panel
ADMIN_PASSWORD=admin_secret_passphrase_change_me
